# Provider credentials belong in provider.tf or another root configuration file.
# This example file contains module inputs only.

# general oci parameters

compartment_id = ""

label_prefix = "dev"

# network parameters

bastion_availability_domain = 1

bastion_allowed_cidrs = ["anywhere"]

bastion_nsg_ids = []

ig_route_id = ""

bastion_route_table_id = null

netnum = 30

newbits = 14

vcn_id = ""

bastion_image_id = null

bastion_image_type = "platform"

bastion_image_os = "Oracle Autonomous Linux"

bastion_image_os_version = "9"

bastion_shape = {
  shape="VM.Standard.E4.Flex",
  ocpus=1,
  memory=4,
  boot_volume_size=50
}

bastion_state= "RUNNING"

bastion_timezone = "Australia/Sydney"

bastion_is_public = true

ssh_public_key = ""

ssh_private_key = ""

ssh_public_key_path = "~/.ssh/id_rsa.pub"

upgrade_bastion = false

bastion_await_cloudinit = false

freeform_tags = {
    access      = "public"
    environment = "dev"
    role        = "bastion"
}
